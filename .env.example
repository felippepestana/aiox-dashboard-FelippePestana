# AIOX Legal Performance — Environment Variables
# Copy to .env and fill in your values

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-random-string

# OpenRouter API (LLM routing — https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase (database — https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DataJud API (optional — https://datajud-wiki.cnj.jus.br/api-publica/)
DATAJUD_API_KEY=

# Court Systems (optional — for future integration)
PJE_USERNAME=
PJE_PASSWORD=
ESAJ_USERNAME=
ESAJ_PASSWORD=
