# ═══════════════════════════════════════════════════════
# APEX Legal Performance — Environment Variables
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
AUTH_SECRET=generate-a-random-32-char-string

# Supabase (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# AI — Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key

# DataJud — CNJ public judiciary API (https://datajud-wiki.cnj.jus.br)
# Request a free key at: https://datajud-wiki.cnj.jus.br/api-publica/acesso
# Without this key, searches fall back to mock data (development only).
DATAJUD_API_KEY=your-datajud-key
# PJE_API_KEY=
# ESAJ_API_KEY=

# Email (optional — for notifications)
# RESEND_API_KEY=re_your-key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
MP_ACCESS_TOKEN=APP_USR-your-access-token
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-your-public-key
# Webhook signature secret — set in your Mercado Pago developer panel.
# Deixe comentado até ter o valor real: um placeholder público NUNCA deve
# virar segredo de assinatura (o webhook o trata como não configurado).
# MP_WEBHOOK_SECRET=

# Cron jobs — set this secret; requests must send "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron sends this header automatically when CRON_SECRET is set)
CRON_SECRET=generate-a-random-32-char-string

# Sentry (https://sentry.io — optional, for production error tracking)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=sntrys_xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=apex-legal
